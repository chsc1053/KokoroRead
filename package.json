{
  "name": "kokororead",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Private, local-first Chrome extension TTS for newsletters and articles using Kokoro.js",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -b && vite build && vite build --config vite.content.config.ts",
    "build:ext": "vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint src",
    "package": "npm run build && cd dist && zip -r ../kokororead.zip .",
    "screenshots": "node scripts/generate-screenshots.mjs"
  },
  "dependencies": {
    "kokoro-js": "^1.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~5.9.2",
    "vite": "^8.1.1"
  }
}
